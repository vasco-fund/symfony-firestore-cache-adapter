{
    "name": "vasco-fund/symfony-firestore-cache-adapter",
    "description": "Symfony Cache adapter for Google Cloud Firestore - Production-ready PSR-6 implementation",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "symfony",
        "cache",
        "firestore",
        "google-cloud",
        "psr-6",
        "psr-16",
        "cloud-run",
        "gcp"
    ],
    "authors": [
        {
            "name": "Rémi Janot",
            "email": "remi@vasco.fund"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "google/auth": "^1.49",
        "psr/cache": "^3.0",
        "psr/log": "^3.0",
        "symfony/cache": "^7.0|^8.0",
        "symfony/cache-contracts": "^3.0",
        "symfony/http-client": "^7.0|^8.0"
    },
    "suggest": {
        "google/cloud-firestore": "Required if using the native Google Cloud SDK client (requires grpc extension)",
        "ext-grpc": "Required for optimal performance with google/cloud-firestore",
        "ext-zlib": "Required for data compression"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-phpunit": "^1.3",
        "phpstan/phpstan-strict-rules": "^1.5",
        "friendsofphp/php-cs-fixer": "^3.48",
        "infection/infection": "^0.31",
        "symfony/var-dumper": "^6.4|^7.0"
    },
    "autoload": {
        "psr-4": {
            "Vasco\\FirestoreCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vasco\\FirestoreCache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse -c phpstan.neon -v",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "infection": "infection --min-msi=97 --min-covered-msi=97",
        "qa": [
            "@cs:check",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
